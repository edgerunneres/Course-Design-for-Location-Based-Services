page {
  background: #f4f1e8;
  color: #17231f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.surface {
  background: #ffffff;
  border: 1px solid rgba(23, 35, 31, 0.08);
  border-radius: 14rpx;
  box-shadow: 0 12rpx 36rpx rgba(16, 35, 31, 0.08);
}

.button-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-wrap: wrap;
}

button {
  margin: 0;
  border-radius: 14rpx;
}

button::after {
  border: none;
}

.primary {
  background: #10231f;
  color: #fff;
}

.secondary {
  background: #d7b46a;
  color: #21190a;
}

.ghost {
  background: #eef1ed;
  color: #17231f;
}

.danger {
  background: #a4382f;
  color: #fff;
}

.field {
  background: #fbfaf5;
  border: 1px solid #e5dfd0;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.label {
  color: #69736d;
  font-size: 23rpx;
  margin-bottom: 8rpx;
}

.value {
  font-size: 29rpx;
  line-height: 1.5;
  color: #17231f;
}

.input {
  min-height: 72rpx;
  font-size: 27rpx;
  color: #17231f;
}

.standalone {
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  padding: 0 18rpx;
  margin-bottom: 16rpx;
  background: #fff;
  box-sizing: border-box;
}
