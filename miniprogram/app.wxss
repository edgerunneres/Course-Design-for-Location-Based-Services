page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.surface {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 16rpx;
  box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, 0.09);
}

.button-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-wrap: wrap;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  border-radius: 16rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: opacity 160ms ease, transform 160ms ease;
}

button::after {
  border: none;
}

button:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.primary {
  background: linear-gradient(135deg, #0a84ff 0%, #0066cc 100%);
  color: #fff;
}

.secondary {
  background: linear-gradient(135deg, #f4d57f 0%, #c59a41 100%);
  color: #21190a;
}

.ghost {
  background: #f2f3f5;
  color: #1d1d1f;
  border: 1px solid rgba(29, 29, 31, 0.08);
  box-shadow: none;
}

.danger {
  background: linear-gradient(135deg, #b84338 0%, #822c27 100%);
  color: #fff;
}

.btn-icon,
.chip-icon,
.title-icon,
.field-icon,
.card-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.btn-icon {
  font-size: 24rpx;
  line-height: 1;
}

.chip-icon {
  font-size: 22rpx;
  line-height: 1;
}

.title-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
  border-radius: 12rpx;
  background: #eef5ff;
  color: #0a84ff;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: center;
}

.section-title {
  display: flex;
  align-items: center;
}

.field {
  background: #fbfbf7;
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.label {
  color: #6b7672;
  font-size: 23rpx;
  margin-bottom: 8rpx;
}

.value {
  font-size: 29rpx;
  line-height: 1.5;
  color: #1d1d1f;
}

.input {
  min-height: 72rpx;
  font-size: 27rpx;
  color: #1d1d1f;
}

.standalone {
  border: 1px solid rgba(29, 29, 31, 0.09);
  border-radius: 14rpx;
  padding: 0 18rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
