page {
  background: #f6f7f3;
  color: #1d2822;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.toolbar {
  background: #ffffff;
  border-bottom: 1px solid #dfe5dd;
  padding: 20rpx 24rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
}

.primary {
  background: #14532d;
  color: #fff;
}

.ghost {
  background: #edf2ec;
  color: #17442b;
}

.danger {
  background: #b42318;
  color: #fff;
}

.field {
  background: #fff;
  border: 1px solid #d9e1d7;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.label {
  color: #5c6a61;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.value {
  font-size: 30rpx;
  line-height: 1.5;
}
