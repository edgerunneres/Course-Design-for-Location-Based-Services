.security-page {
  padding: 24rpx;
  background: #f5f5f7;
}

.security-hero {
  padding: 26rpx 4rpx 24rpx;
}

.hero-lockup {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  line-height: 76rpx;
  text-align: center;
  flex: none;
  background: linear-gradient(145deg, #1d1d1f, #3a3a3c);
  color: #0a84ff;
  font-size: 36rpx;
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.18);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #1d1d1f;
}

.section {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 900;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.demo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.demo-btn,
.full {
  height: 74rpx;
  font-size: 26rpx;
}

.full {
  width: 100%;
}

.top-gap {
  margin-top: 16rpx;
}

.progress-text {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fff8e1;
  color: #6c4f0e;
  font-size: 24rpx;
}

.empty {
  padding: 28rpx 12rpx;
  color: #68736d;
  font-size: 25rpx;
  line-height: 1.45;
}

.result-card {
  padding: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #fbfbf7;
  border: 1px solid rgba(29, 29, 31, 0.08);
}

.result-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
}

.result-title {
  flex: 1;
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 800;
}

.result-status {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #0a84ff;
  color: #fff;
  font-size: 22rpx;
}

.result-code {
  margin-top: 12rpx;
  color: #a4382f;
  font-size: 27rpx;
  font-weight: 900;
}

.result-message,
.result-id {
  margin-top: 8rpx;
  color: #68736d;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}
