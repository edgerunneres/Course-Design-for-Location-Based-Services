.admin-page {
  padding: 24rpx;
  background: #f4f1e8;
}

.admin-hero {
  padding: 26rpx 4rpx 24rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #10231f;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #68736d;
  font-size: 25rpx;
  line-height: 1.45;
}

.section {
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 900;
  color: #10231f;
  margin-bottom: 16rpx;
}

.section-desc {
  color: #68736d;
  font-size: 23rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  background: #fff;
}

.full {
  width: 100%;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.action {
  flex: 1;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}
