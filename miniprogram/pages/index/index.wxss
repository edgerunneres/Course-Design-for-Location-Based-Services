.index-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #eef0ea;
}

.map {
  width: 100%;
  height: 100vh;
}

.center-target {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 54rpx;
  height: 54rpx;
  margin-left: -27rpx;
  margin-top: -27rpx;
  z-index: 1;
  pointer-events: none;
}

.target-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 54rpx;
  height: 54rpx;
  border: 4rpx solid #a4382f;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.46);
}

.target-dot {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #a4382f;
}

.search-console {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 22rpx;
  z-index: 2;
}

.brand-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.eyebrow {
  color: #8b6f2e;
  font-size: 21rpx;
  letter-spacing: 0;
}

.brand-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #10231f;
}

.count-pill {
  min-width: 96rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #10231f;
  color: #fff;
  font-size: 23rpx;
  text-align: center;
}

.search-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 74rpx;
  padding: 0 22rpx;
  background: #f7f5ee;
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}

.search-btn {
  width: 132rpx;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.quick-row {
  display: grid;
  grid-template-columns: 1fr 1fr 0.78fr 0.78fr 0.78fr;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.quick-chip {
  min-height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #eef1ed;
  color: #17231f;
  font-size: 24rpx;
}

.radius-chip {
  background: #fff8e4;
  color: #6c4f0e;
}

.quick-chip.active {
  background: #d7b46a;
  color: #21190a;
  font-weight: 700;
}

.quick-chip.muted {
  color: #68736d;
}

.filter-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.filter-control {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 14rpx;
  background: #ffffff;
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  color: #263630;
  font-size: 23rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ext-control {
  background: #fbfaf5;
}

.result-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fffdf8;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -18rpx 42rpx rgba(16, 35, 31, 0.16);
  padding: 0 22rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  z-index: 3;
  transition: height 180ms ease;
}

.sheet-collapsed {
  height: 24vh;
}

.sheet-half {
  height: 46vh;
}

.sheet-expanded {
  height: 74vh;
}

.sheet-grip-zone {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-handle {
  width: 84rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #bfb6a4;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  color: #10231f;
  font-size: 31rpx;
  font-weight: 800;
}

.sheet-subtitle {
  color: #68736d;
  font-size: 23rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.small-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 24rpx;
}

.poi-list {
  height: calc(100% - 116rpx);
}

.poi-item {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #eee7d8;
}

.poi-main {
  flex: 1;
  min-width: 0;
}

.poi-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #10231f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b6f2e;
}

.poi-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4d5a54;
  line-height: 1.45;
}

.poi-extra {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #fbf2d7;
  color: #6c4f0e;
  font-size: 22rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.poi-side {
  width: 94rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.distance,
.ext-dot {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.distance {
  background: #eef1ed;
  color: #2b3b35;
}

.ext-dot {
  background: #f2e3ba;
  color: #6c4f0e;
}

.empty {
  padding: 58rpx 20rpx;
  text-align: center;
  color: #68736d;
  font-size: 26rpx;
}
