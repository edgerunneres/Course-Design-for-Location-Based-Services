.index-page {
  display: flex;
  flex-direction: column;
}

.map {
  width: 100%;
  height: 48vh;
}

.panel {
  background: #f6f7f3;
  padding: 20rpx 22rpx 0;
}

.search-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1px solid #d9e1d7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.search-btn {
  width: 150rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.filter-chip {
  min-height: 70rpx;
  line-height: 70rpx;
  padding: 0 18rpx;
  background: #ffffff;
  border: 1px solid #d9e1d7;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #254131;
}

.switch-chip {
  grid-column: span 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  line-height: 1;
}

.action-row {
  margin-top: 16rpx;
}

.action-row button {
  min-width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  font-size: 25rpx;
  margin: 0;
}

.summary {
  padding: 18rpx 4rpx 12rpx;
  color: #607066;
  font-size: 24rpx;
}

.poi-list {
  height: calc(52vh - 278rpx);
}

.poi-item {
  background: #ffffff;
  border: 1px solid #dfe5dd;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.poi-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #153d28;
}

.poi-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #59665e;
}

.poi-address {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #2f3a33;
  line-height: 1.45;
}
