.index-page {
  position: relative;
  overflow: hidden;
  background: #f4f1e8;
}

.map {
  width: 100%;
  height: 56vh;
}

.search-console {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 22rpx;
  z-index: 2;
}

.brand-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.eyebrow {
  color: #8b6f2e;
  font-size: 21rpx;
  letter-spacing: 0;
}

.brand-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #10231f;
}

.count-pill {
  min-width: 96rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #10231f;
  color: #fff;
  font-size: 23rpx;
  text-align: center;
}

.search-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 74rpx;
  padding: 0 22rpx;
  background: #f7f5ee;
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 27rpx;
}

.search-btn {
  width: 132rpx;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.quick-chip {
  flex: 1;
  min-height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #eef1ed;
  color: #17231f;
  font-size: 24rpx;
}

.quick-chip.active {
  background: #d7b46a;
  color: #21190a;
  font-weight: 700;
}

.quick-chip.muted {
  color: #68736d;
}

.filter-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.filter-control {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 14rpx;
  background: #ffffff;
  border: 1px solid #ded8c9;
  border-radius: 12rpx;
  color: #263630;
  font-size: 23rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ext-control {
  background: #fbfaf5;
}

.result-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 47vh;
  background: #fffdf8;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -18rpx 42rpx rgba(16, 35, 31, 0.12);
  padding: 12rpx 22rpx 0;
  box-sizing: border-box;
  z-index: 3;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d8d0bf;
  margin: 0 auto 14rpx;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sheet-title {
  color: #10231f;
  font-size: 31rpx;
  font-weight: 800;
}

.sheet-subtitle {
  color: #68736d;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.small-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 24rpx;
}

.poi-list {
  height: calc(47vh - 112rpx);
}

.poi-item {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #eee7d8;
}

.poi-main {
  flex: 1;
  min-width: 0;
}

.poi-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #10231f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b6f2e;
}

.poi-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4d5a54;
  line-height: 1.45;
}

.poi-side {
  width: 94rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.distance,
.ext-dot {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.distance {
  background: #eef1ed;
  color: #2b3b35;
}

.ext-dot {
  background: #f2e3ba;
  color: #6c4f0e;
}

.empty {
  padding: 58rpx 20rpx;
  text-align: center;
  color: #68736d;
  font-size: 26rpx;
}
