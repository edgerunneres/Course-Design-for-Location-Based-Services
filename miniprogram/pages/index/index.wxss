.index-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #eef3f8;
}

.map {
  width: 100%;
  height: 100vh;
}

.center-target {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 54rpx;
  height: 54rpx;
  margin-left: -27rpx;
  margin-top: -27rpx;
  z-index: 1;
  pointer-events: none;
}

.target-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 54rpx;
  height: 54rpx;
  border: 4rpx solid #0a84ff;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 0 0 10rpx rgba(10, 132, 255, 0.12);
}

.target-dot {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #0a84ff;
}

.search-console {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 24rpx;
  z-index: 2;
}

.brand-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  line-height: 64rpx;
  text-align: center;
  background: linear-gradient(145deg, #1d1d1f, #3a3a3c);
  color: #0a84ff;
  font-size: 32rpx;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.18);
}

.eyebrow {
  color: #6f806d;
  font-size: 21rpx;
  letter-spacing: 0;
}

.brand-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1d1d1f;
}

.count-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 96rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #0a84ff;
  color: #fff;
  font-size: 23rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.18);
}

.search-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.search-input-wrap {
  flex: 1;
  height: 74rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 20rpx;
  background: #f7f8fa;
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.native-search-icon {
  flex: none;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0;
  background: transparent;
  font-size: 27rpx;
}

.search-btn {
  width: 132rpx;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.quick-row {
  display: grid;
  grid-template-columns: 1fr 1fr 0.78fr 0.78fr 0.78fr;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.quick-chip {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f2f3f5;
  color: #1d1d1f;
  font-size: 23rpx;
}

.radius-chip {
  background: #fff8e1;
  color: #6c4f0e;
}

.quick-chip.active {
  background: #0a84ff;
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(10, 132, 255, 0.18);
  font-weight: 700;
}

.quick-chip.active .chip-icon {
  color: #ffffff;
  font-weight: 700;
}

.quick-chip.muted {
  color: #68736d;
}

.filter-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.filter-control {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 14rpx;
  background: #ffffff;
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 14rpx;
  color: #1d1d1f;
  font-size: 23rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ext-control {
  background: #f7faff;
}

.filter-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fffefb;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -24rpx 56rpx rgba(0, 0, 0, 0.14);
  padding: 0 22rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  z-index: 3;
  transition: height 180ms ease;
}

.sheet-dragging {
  transition: none;
}

.sheet-grip-zone {
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-handle {
  width: 84rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #ccd4d0;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sheet-copy {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 800;
}

.sheet-subtitle {
  color: #68736d;
  font-size: 23rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.small-btn {
  width: 140rpx;
  flex: none;
  height: 58rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.poi-list {
  height: calc(100% - 116rpx);
}

.poi-item {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid rgba(29, 29, 31, 0.08);
}

.poi-icon {
  width: 48rpx;
  height: 48rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  line-height: 48rpx;
  text-align: center;
  flex: none;
  background: #eef5ff;
  color: #0a84ff;
  font-size: 24rpx;
}

.poi-main {
  flex: 1;
  min-width: 0;
}

.poi-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d1d1f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #80672c;
}

.poi-address {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4d5a54;
  line-height: 1.45;
}

.poi-extra {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #fff6d9;
  color: #6c4f0e;
  font-size: 22rpx;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.poi-side {
  width: 94rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.distance,
.ext-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.distance {
  background: #eef5ff;
  color: #2b3b35;
}

.ext-dot {
  background: #f2e3ba;
  color: #6c4f0e;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 58rpx 20rpx;
  text-align: center;
  color: #68736d;
  font-size: 26rpx;
}

.empty-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  line-height: 64rpx;
  text-align: center;
  background: #eef3f1;
  color: #0a84ff;
  font-size: 32rpx;
}
