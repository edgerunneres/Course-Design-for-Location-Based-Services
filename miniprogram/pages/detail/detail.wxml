<view class="page detail-page" wx:if="{{item}}">
  <map
    class="detail-map"
    latitude="{{item.gcjLat || item.lat}}"
    longitude="{{item.gcjLng || item.lng}}"
    scale="14"
    markers="{{markers}}"
    show-location
  />

  <view class="detail-body">
    <view class="title">{{item.name}}</view>
    <view class="tag-row">
      <text class="tag">{{item.province}}</text>
      <text class="tag">{{item.type}}</text>
      <text class="tag">{{item.batch}}</text>
    </view>

    <view class="field">
      <view class="label">时代</view>
      <view class="value">{{item.age || '暂无'}}</view>
    </view>
    <view class="field">
      <view class="label">地址</view>
      <view class="value">{{item.address}}</view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <view class="value">{{item.remark || '暂无扩展备注'}}</view>
    </view>
    <view class="field">
      <view class="label">坐标</view>
      <view class="value">GCJ-02: {{item.gcjLng}}, {{item.gcjLat}}</view>
    </view>

    <view class="button-row">
      <button class="ghost" bindtap="copyJson">复制 JSON</button>
      <button wx:if="{{item.website}}" class="primary" bindtap="copyWebsite">复制资料链接</button>
    </view>
  </view>
</view>

<view class="page loading" wx:else>正在加载详情...</view>
