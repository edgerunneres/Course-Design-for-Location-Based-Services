<view class="page detail-page" wx:if="{{item}}">
  <map
    class="detail-map"
    latitude="{{item.gcjLat || item.lat}}"
    longitude="{{item.gcjLng || item.lng}}"
    scale="14"
    markers="{{markers}}"
    show-location
  />

  <view class="place-card surface">
    <view class="place-kicker">{{item.province}} · {{item.batch}}</view>
    <view class="place-title">{{item.name}}</view>
    <view class="tag-row">
      <text class="tag strong">{{item.type}}</text>
      <text class="tag">{{item.age || '时代待考'}}</text>
      <text class="tag" wx:if="{{item.hasExt}}">含扩展资料</text>
    </view>

    <view class="action-grid">
      <button class="primary" bindtap="openLocation">地图导航</button>
      <button class="ghost" bindtap="copyJson">复制 JSON</button>
      <button wx:if="{{item.website}}" class="secondary" bindtap="copyWebsite">资料链接</button>
    </view>
  </view>

  <view class="detail-body">
    <view class="section-title">基础信息</view>
    <view class="info-grid">
      <view class="field">
        <view class="label">地址</view>
        <view class="value">{{item.address}}</view>
      </view>
      <view class="field">
        <view class="label">备注</view>
        <view class="value">{{item.remark || '暂无扩展备注'}}</view>
      </view>
      <view class="field">
        <view class="label">服务坐标</view>
        <view class="value">GCJ-02 {{item.gcjLng}}, {{item.gcjLat}}</view>
      </view>
      <view class="field">
        <view class="label">原始编号</view>
        <view class="value">{{item.code}} / {{item.classCode}}</view>
      </view>
    </view>
  </view>
</view>

<view class="page loading" wx:else>正在加载详情...</view>
