<view class="page detail-page" wx:if="{{item}}">
  <map
    class="detail-map"
    latitude="{{item.gcjLat || item.lat}}"
    longitude="{{item.gcjLng || item.lng}}"
    scale="14"
    markers="{{markers}}"
    show-location
  />

  <view class="place-card surface">
    <view class="place-kicker">{{item.province}} · {{item.batch}}</view>
    <view class="place-title">{{item.name}}</view>
    <view class="tag-row">
      <text class="tag strong">{{item.type}}</text>
      <text class="tag">{{item.age || '时代待考'}}</text>
      <text class="tag" wx:if="{{item.hasExt}}">含扩展资料</text>
    </view>

    <view class="action-grid">
      <button class="primary" bindtap="openLocation">地图导航</button>
      <button class="ghost" bindtap="copyCoordinates">复制坐标</button>
      <button wx:if="{{item.website}}" class="secondary" bindtap="openWebsite">打开资料</button>
    </view>
  </view>

  <view class="detail-body">
    <view class="section-title">基础信息</view>
    <view class="info-grid">
      <view class="field">
        <view class="label">地址</view>
        <view class="value">{{item.address}}</view>
      </view>
      <view class="field">
        <view class="label">时代</view>
        <view class="value">{{item.age || '时代待考'}}</view>
      </view>
      <view class="field">
        <view class="label">原始编号</view>
        <view class="value">{{item.code}} / {{item.classCode}}</view>
      </view>
    </view>

    <view class="section-title ext-title">扩展信息</view>
    <image wx:if="{{item.imageUrl}}" class="heritage-image" mode="aspectFill" src="{{item.imageUrl}}" bindtap="previewImage" />
    <view class="info-grid">
      <view class="field highlight">
        <view class="label">备注</view>
        <view class="value">{{item.remark || '暂无扩展备注'}}</view>
      </view>
      <view class="field" wx:if="{{item.website}}">
        <view class="label">资料链接</view>
        <view class="value link-text" bindtap="openWebsite">{{item.website}}</view>
      </view>
      <view class="field">
        <view class="label">保护批次</view>
        <view class="value">{{item.batch || '未填'}}</view>
      </view>
      <view class="field">
        <view class="label">数据状态</view>
        <view class="value">{{item.hasExt ? '含扩展资料' : '基础 POI 数据'}}</view>
      </view>
      <view class="field">
        <view class="label">WGS84 坐标</view>
        <view class="value">{{item.lng}}, {{item.lat}}</view>
      </view>
      <view class="field">
        <view class="label">GCJ-02 坐标</view>
        <view class="value">{{item.gcjLng}}, {{item.gcjLat}}</view>
      </view>
      <view class="field">
        <view class="label">BD-09 坐标</view>
        <view class="value">{{item.bdLng}}, {{item.bdLat}}</view>
      </view>
      <view class="field">
        <view class="label">更新时间</view>
        <view class="value">{{item.updatedAt}}</view>
      </view>
    </view>
    <view class="button-row detail-actions">
      <button class="ghost action" bindtap="copyJson">复制完整 JSON</button>
      <button wx:if="{{item.website}}" class="ghost action" bindtap="copyWebsite">复制链接</button>
    </view>
  </view>
</view>

<view class="page loading" wx:else>正在加载详情...</view>
