.detail-map {
  width: 100%;
  height: 38vh;
}

.detail-body {
  padding: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  color: #153d28;
  line-height: 1.25;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 24rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: #e9f2e8;
  color: #17442b;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.detail-body button {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin: 0;
}

.loading {
  padding: 40rpx;
  color: #607066;
}
