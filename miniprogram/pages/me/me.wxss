.account-page {
  padding: 24rpx;
  background: #f5f5f7;
}

.account-hero {
  padding: 26rpx 4rpx 24rpx;
}

.hero-lockup {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.hero-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  line-height: 76rpx;
  text-align: center;
  flex: none;
  background: linear-gradient(145deg, #1d1d1f, #3a3a3c);
  color: #0a84ff;
  font-size: 36rpx;
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.18);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #1d1d1f;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #68736d;
  font-size: 25rpx;
  line-height: 1.45;
}

.section {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 900;
  color: #1d1d1f;
  margin-bottom: 14rpx;
}

.compact-title {
  margin-bottom: 6rpx;
}

.section-desc {
  color: #68736d;
  font-size: 23rpx;
  line-height: 1.4;
}

.full {
  width: 100%;
  height: 74rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.action {
  flex: 1;
  height: 72rpx;
  font-size: 25rpx;
}

.top-gap {
  margin-top: 16rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1f6ff 100%);
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 16rpx;
  margin: 16rpx 0;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(145deg, #0a84ff, #0066cc);
  color: #ffffff;
  font-weight: 900;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d1d1f;
}

.profile-meta {
  margin-top: 6rpx;
  color: #68736d;
  font-size: 23rpx;
}

.role-pill {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #0a84ff;
  color: #fff;
  font-size: 21rpx;
}

.profile-form {
  margin: 18rpx 0;
  padding: 18rpx;
  background: #ffffff;
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 16rpx;
}

.section-subtitle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1d1d1f;
  font-size: 27rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.key-box {
  padding: 18rpx;
  background: #ffffff;
  border: 1px solid rgba(29, 29, 31, 0.08);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.key-value {
  color: #1d1d1f;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.hint {
  margin-top: 14rpx;
  color: #68736d;
  font-size: 23rpx;
  line-height: 1.45;
}

.debug-section {
  background: #ffffff;
}

.debug-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.debug-toggle {
  flex: none;
  min-width: 72rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #0a84ff;
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}
