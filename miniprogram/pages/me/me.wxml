<view class="page account-page">
  <view class="account-hero">
    <view class="hero-title">公众 API 账户</view>
    <view class="hero-subtitle">注册、登录、管理 APIKEY，用于访问专题 POI 服务。</view>
  </view>

  <view class="section surface">
    <view class="section-head">
      <view>
        <view class="section-title">服务配置</view>
        <view class="section-desc">本地调试使用 127.0.0.1，真机演示替换为 HTTPS 域名。</view>
      </view>
    </view>
    <view class="field">
      <view class="label">API 地址</view>
      <input class="input" value="{{apiBase}}" bindinput="onApiBaseInput" />
    </view>
    <view class="field">
      <view class="label">APIKEY</view>
      <input class="input" value="{{apiKey}}" bindinput="onApiKeyInput" />
    </view>
    <view class="button-row">
      <button class="primary wide" bindtap="saveConfig">保存配置</button>
      <button class="ghost compact" bindtap="copyApiKey">复制 Key</button>
    </view>
  </view>

  <view class="section surface" wx:if="{{user}}">
    <view class="section-title">当前用户</view>
    <view class="profile-card">
      <view class="avatar">{{userInitial}}</view>
      <view>
        <view class="profile-name">{{user.nickname}}</view>
        <view class="profile-meta">{{user.username}} · {{user.role}}</view>
      </view>
    </view>
    <button class="ghost full" bindtap="rotateApiKey">重新生成 APIKEY</button>
  </view>

  <view class="section surface">
    <view class="section-title">注册公众用户</view>
    <input class="input standalone" placeholder="用户名" value="{{register.username}}" bindinput="onRegisterUsername" />
    <input class="input standalone" password placeholder="密码" value="{{register.password}}" bindinput="onRegisterPassword" />
    <input class="input standalone" placeholder="昵称" value="{{register.nickname}}" bindinput="onRegisterNickname" />
    <button class="secondary full" bindtap="registerUser">注册并获取 APIKEY</button>
  </view>

  <view class="section surface">
    <view class="section-title">登录</view>
    <input class="input standalone" placeholder="用户名" value="{{login.username}}" bindinput="onLoginUsername" />
    <input class="input standalone" password placeholder="密码" value="{{login.password}}" bindinput="onLoginPassword" />
    <button class="primary full" bindtap="loginUser">登录</button>
  </view>
</view>
